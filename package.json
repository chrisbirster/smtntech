{
  "name": "south-mountain-technologies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "infra:check": "bun --cwd infra run check",
    "infra:deploy": "bun --cwd infra run deploy:production"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.16",
    "@solidjs/web": "2.0.0-rc.0",
    "solid-js": "2.0.0-rc.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-solid": "3.0.0-next.27"
  }
}
